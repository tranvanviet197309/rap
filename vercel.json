{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/stream/:id",
      "destination": "/api/stream/[id].js?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" }
      ]
    }
  ]
}
