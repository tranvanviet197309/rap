# =============================================================================
# CINEVAULT: CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép file này thành `.env` khi chạy ở máy cá nhân hoặc điền vào bảng
# Environment Variables trên Render.com và Vercel.com
# =============================================================================

# 1. TELEGRAM BOT (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_here"

# Danh sách Telegram User ID được phép gửi/xoá phim (ngăn cách bằng dấu phẩy).
# Lấy ID của bạn bằng cách nhắn tin cho @userinfobot trên Telegram.
# Nếu để trống "", tất cả mọi người biết tên Bot đều có thể thêm phim.
ALLOWED_USER_IDS="123456789,987654321"

# 2. SUPABASE DATABASE (Lấy tại Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Key công khai dùng cho Frontend (index.html, movie.html) và đọc dữ liệu
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_your_anon_public_key"

# Key quyền cao nhất dùng cho Telegram Bot (bot.py) và Vercel Proxy để ghi/đọc dữ liệu
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_your_service_role_secret_key"

# 3. ĐỊA CHỈ TRANG WEB RẠP PHIM (Domain Vercel của bạn, không có dấu / ở cuối)
WEB_APP_URL="https://my-cinema.vercel.app"

# 4. CỔNG CHẠY HEALTH CHECK SERVER CHO RENDER (Mặc định 10000)
PORT="10000"
